# Configuration EmailJS — formulaire de contact
#
# Ces variables sont configurées dans Vercel (projet web-portfolio) et
# injectées au moment du build.
#
# → En production : rien à faire ici, le build Vercel récupère les variables.
# → En local : copie ce fichier en `.env` avec les mêmes valeurs, puis `pnpm dev`.
#
#   cp .env.example .env
#
# Préfixe `VITE_` obligatoire : Vite n'injecte dans le bundle que les
# variables portant ce préfixe.

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
